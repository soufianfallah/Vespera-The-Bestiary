{
  "name": "vespera-bestiary",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "python -m http.server 3001 --directory out",
    "check": "npm run typecheck && npm run lint && npm run build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "data:extract": "python scripts/parse_bestiary.py extract",
    "data:assets": "python scripts/parse_bestiary.py assets",
    "data:validate": "python scripts/parse_bestiary.py validate",
    "data:all": "python scripts/parse_bestiary.py all",
    "data:research": "python scripts/enrich_bestiary.py --fetch",
    "data:enrich": "python scripts/enrich_bestiary.py --apply",
    "assets:optimize": "python scripts/optimize_assets.py",
    "assets:favicon": "python scripts/create_favicons.py"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "framer-motion": "^12.23.12",
    "gsap": "^3.13.0",
    "lenis": "^1.3.8",
    "next": "^15.5.22",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-icons": "^5.5.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.22",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2"
  }
}
